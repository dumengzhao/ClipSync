# ClipSync Relay Server 反代示例（nginx 终止 TLS）
# 用法：把本文件放到 /etc/nginx/conf.d/clipsync.conf（或 sites-enabled/），
#       改好 server_name 与证书路径，nginx -t && systemctl reload nginx
# 前置：证书文件（如 Let's Encrypt 的 fullchain.pem / privkey.pem）

# WebSocket 升级头映射（必须，/ws 长连接靠它）
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name relay.example.com;   # 改成你的域名

    ssl_certificate     /etc/ssl/clipsync/fullchain.pem;
    ssl_certificate_key /etc/ssl/clipsync/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 健康检查（可选，便于探针）
    location = /healthz {
        proxy_pass http://127.0.0.1:20070;
        proxy_set_header Host $host;
    }

    # 管理 REST API（含 /api/admin/update 大包上传，需放宽体积）
    location /api/admin {
        proxy_pass http://127.0.0.1:20070;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 256m;   # 更新安装包上传（与 UPDATE_MAX_UPLOAD_MB 对齐）
    }

    # 客户端更新托管（公开读；TLS 在此终止，是无签名更新模型唯一安全边界）
    location /update/ {
        proxy_pass http://127.0.0.1:20070;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 256m;
    }

    # 管理页面（rust-embed 内嵌，单页）
    location /admin {
        proxy_pass http://127.0.0.1:20070;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 设备 WebSocket 长连接（心跳保活，给足超时）
    location /ws {
        proxy_pass http://127.0.0.1:20070;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# HTTP 80 强制跳 HTTPS（可选）
server {
    listen 80;
    listen [::]:80;
    server_name relay.example.com;
    return 301 https://$host$request_uri;
}
