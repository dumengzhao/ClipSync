# ClipSync Relay Server 环境变量（由 systemd EnvironmentFile 读取）
# 复制本文件为 clipsync-server.env 并修改后使用

# 数据存储目录（含 networks.json / server.key）
CLIPSYNC_DATA_DIR=/opt/clipsync-server/data

# 管理后台账号密码（留空则首次部署自动随机生成，建议登录后改强密码）
ADMIN_USER=admin
ADMIN_PASS=

# 监听地址（中继服务端口，桌面端填 ip:20070 接入）
LISTEN=0.0.0.0:20070

# ---- 客户端更新托管（可选，见 UPDATE_MODULE_PLAN.md）----
# 更新文件根目录（latest.json 与 files/<platform>/），默认 <CLIPSYNC_DATA_DIR>/update
#UPDATE_DIR=/opt/clipsync-server/data/update

# 生成 latest.json 下载链接用的公开基址（生产强烈建议显式设置，如 https://sync.example.com）。
# 缺省时回退请求头 X-Forwarded-Proto/Origin，且仅接受 https；无法确定时 latest.json 返回 500。
#UPDATE_PUBLIC_BASE=https://sync.example.com

# 管理端单次上传总大小上限（MB），默认 200；需与 nginx client_max_body_size 对齐
#UPDATE_MAX_UPLOAD_MB=200
