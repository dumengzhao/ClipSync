{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipSync",
  "version": "0.1.0",
  "identifier": "com.dumengzhao.clipsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipSync",
        "width": 800,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "ClipSync Dev"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 dumengzhao",
    "category": "Utility",
    "shortDescription": "Cross-platform clipboard sync",
    "longDescription": "Cross-platform clipboard sync tool with delayed file rendering."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/dumengzhao/ClipSync/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMkNCNTlFRjU4NDcyRkJKUldUN2NvVDFuclVzMEpMdDhuTEYyT0htYzk1a0Z4SWlKTFdodmVUc3JoN0kvcy8xRzJJV0NhUWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
